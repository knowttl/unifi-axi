{
  "name": "@knowttl/unifi-axi",
  "version": "0.1.0",
  "description": "Protected credentials and verified transport for the UniFi Network Integration API",
  "type": "module",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/knowttl/unifi-axi.git" },
  "bin": { "unifi-axi": "dist/bin.js" },
  "exports": {
    "./catalogue": "./dist/catalogue.js",
    "./capabilities": "./dist/capabilities.json",
    "./skill": "./dist/SKILL.md",
    "./credential-schema": "./dist/axi-credential.schema.json"
  },
  "files": ["dist", "evidence/sources"],
  "engines": { "node": ">=24.11.0" },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "tsc && node scripts/metadata.mjs",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tooling.json && tsc -p test/tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm verify:package-contract && pnpm verify:packaged -- --task B3.3 && pnpm verify:contracts && node --test test/private-file.mjs test/paging.mjs test/transport.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm verify:package-contract && pnpm verify:packaged && pnpm verify:contracts && node --test test/private-file.mjs test/paging.mjs test/transport.mjs",
    "verify:package-contract": "node test/package-contract.ts",
    "verify:packaged": "node scripts/verify-packaged.mjs",
    "verify:contracts": "pnpm build && node scripts/verify-contracts.mjs",
    "verify:artium": "node scripts/verify-artium.mjs"
  },
  "dependencies": { "@decimalturn/toml-patch": "3.3.2", "@toon-format/toon": "2.3.1" },
  "devDependencies": {
    "@types/node": "24.10.0",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3"
  }
}
