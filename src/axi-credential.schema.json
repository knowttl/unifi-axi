{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UniFi AXI profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["origin"],
  "properties": {
    "origin": { "type": "string", "format": "uri", "pattern": "^https://[^/?#@]+/?$" },
    "apiKey": {
      "x-secret": true,
      "default": { "env": "UNIFI_AXI_API_KEY" },
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["env"], "properties": { "env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } } },
        { "type": "object", "additionalProperties": false, "required": ["file"], "properties": { "file": { "type": "string", "pattern": "^(?:/|[A-Za-z]:[\\\\/])" } } }
      ]
    },
    "siteId": { "type": "string", "minLength": 1 },
    "apiContract": { "enum": ["10.6.109", "11.0.97"] },
    "tls": {
      "type": "object", "additionalProperties": false,
      "required": ["trustedCertificatePem", "peerFingerprintSha256"],
      "properties": {
        "trustedCertificatePem": { "type": "string", "pattern": "^\\s*-----BEGIN CERTIFICATE-----[A-Za-z0-9+/=\\s]+-----END CERTIFICATE-----\\s*$" },
        "peerFingerprintSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "connectAddress": { "oneOf": [{ "type": "string", "format": "ipv4" }, { "type": "string", "format": "ipv6" }] }
      }
    },
    "writes": {
      "type": "object", "additionalProperties": false, "required": ["allowWrites", "operations"],
      "properties": {
        "allowWrites": { "type": "boolean" },
        "operations": { "type": "array", "items": { "type": "string", "pattern": "^(?:OP-[0-9]{3}|[A-Za-z][A-Za-z0-9]*(?::[A-Z][A-Z0-9_]*)?)$" } }
      }
    }
  }
}
